---
/**
 * The story homepage shell — identical to v6's base template. Its styles and
 * scripts are the files in static/css and static/js; the nav and footer come
 * from components. The top bar runs the same code as the inner pages
 * (src/scripts/nav.ts via home-nav.ts); static/js/shell.js keeps the detective.
 */
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import '../styles/footer.css';
import SearchDialog from '../components/site/SearchDialog.astro';
import '../styles/glass.css';
import '../styles/search.css';
/* the top bar is shared with the inner pages: its material and styles */
import '../styles/liquid-glass.css';
import '../styles/nav.css';
import { mascotHtml } from '../lib/home';

interface Props { title: string; description: string; homeData: string }
const { title, description, homeData } = Astro.props;
// These authored files bypass Astro's bundled-asset hashing. Change their URL
// whenever the source changes so returning readers receive the current version.
const staticAsset = (file: string) => `/${file}?v=${createHash('sha256')
  .update(readFileSync(`${process.cwd()}/static/${file}`)).digest('hex').slice(0, 16)}`;
const styles = ['style', 'home', 'home-v6', 'shell', 'home-round1', 'home-ascr', 'home-mobile', 'home-r2'];
const scripts = ['vendor/three.min', 'home-geo', 'home-land', 'home-geo3d', 'home-abundance', 'home-maps-data', 'home-hp-data', 'home-core', 'home-nk', 'home-pager', 'home-opening', 'home-maps', 'home-field-camera', 'home-zoom3d', 'home-threat-r1', 'home-ascr-story', 'home-story'];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1a0d1d" />
  <link rel="icon" href="https://static.igem.wiki/teams/6303/wiki/v8-0/v8-3439b58a1e73-nku-mark.svg" type="image/svg+xml" />
  <link rel="preload" href="https://static.igem.wiki/teams/6303/wiki/v8-0/v8-64513365c2d8-spline-variable.woff2" as="font" type="font/woff2" crossorigin />
  {styles.map((name) => <link rel="stylesheet" href={staticAsset(`css/${name}.css`)} />)}
</head>
<body class="page-home home" data-path-prefix="">
  <a class="skip" href="#main">Skip to content</a>
  <div class="scroll-progress" aria-hidden="true"></div>
  <SiteNav current="/index.html" />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  <SearchDialog />
  <Fragment set:html={mascotHtml()} />
  <!-- Shared search loads the manuscript-versioned index when opened. -->
  <script is:inline src={staticAsset('js/main.js')} defer></script>
  <script is:inline src={staticAsset('js/shell.js')} defer></script>
  <script>import '../scripts/home-nav.ts';</script>
  <script is:inline set:html={`window.NKU_HOME = ${homeData};`}></script>
  {scripts.map((name) => <script is:inline src={staticAsset(`js/${name}.js`)} defer></script>)}
</body>
</html>
