---
/**
 * The story homepage shell — identical to v6's base template. Its styles and
 * scripts are the untouched files in static/css and static/js; only the nav
 * and footer come from components (same markup as before).
 */
import SiteNav from '../components/site/SiteNav.astro';
import { homeFooter, mascotHtml } from '../lib/home';

interface Props { title: string; description: string; homeData: string }
const { title, description, homeData } = Astro.props;
const styles = ['style', 'home', 'home-v6', 'shell'];
const scripts = ['vendor/three.min', 'home-geo', 'home-land', 'home-geo3d', 'home-abundance', 'home-maps-data', 'home-core', 'home-nk', 'home-pager', 'home-opening', 'home-maps', 'home-zoom3d', 'home-threat', 'home-story'];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1a0d1d" />
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/spline-variable.woff2" as="font" type="font/woff2" crossorigin />
  {styles.map((name) => <link rel="stylesheet" href={`/css/${name}.css`} />)}
</head>
<body class="page-home home" data-path-prefix="">
  <a class="skip" href="#main">Skip to content</a>
  <div class="scroll-progress" aria-hidden="true"></div>
  <SiteNav current="/index.html" />
  <main id="main">
    <slot />
  </main>
  <Fragment set:html={homeFooter()} />
  <div class="site-search" id="site-search" role="dialog" aria-modal="true" aria-labelledby="site-search-title" hidden>
    <div class="site-search__backdrop" data-search-close></div>
    <section class="site-search__panel" role="document">
      <div class="site-search__head">
        <div>
          <p class="eyebrow">Search the wiki</p>
          <h2 id="site-search-title">Find articles, sections, and evidence.</h2>
        </div>
        <button class="site-search__close" type="button" data-search-close aria-label="Close search">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
        </button>
      </div>
      <label class="site-search__box">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="20" y1="20" x2="16.5" y2="16.5" /></svg>
        <span class="sr-only">Search query</span>
        <input type="search" data-search-input autocomplete="off" spellcheck="false" placeholder="Search project content..." />
      </label>
      <div class="site-search__meta" data-search-meta>Type to search the full wiki.</div>
      <div class="site-search__results" data-search-results></div>
    </section>
  </div>
  <Fragment set:html={mascotHtml()} />
  <script is:inline src="/js/search-data.js"></script>
  <script is:inline src="/js/main.js"></script>
  <script is:inline src="/js/shell.js"></script>
  <script is:inline set:html={`window.NKU_HOME = ${homeData};`}></script>
  {scripts.map((name) => <script is:inline src={`/js/${name}.js`} defer></script>)}
</body>
</html>
