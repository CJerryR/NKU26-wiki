---
/** Shell for every inner page: glass nav, footer, search, detective. */
import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SearchDialog from '../components/site/SearchDialog.astro';
import Mascot from '../components/site/Mascot.astro';
import { site } from '../data/site';

interface Props { title: string; description?: string; current?: string }
const { title, description = site.description, current } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-root="/">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{`${title} / ${site.title}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191222" />
    <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/spline-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="wiki" data-page-title={title}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <SearchDialog />
    <Mascot />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
