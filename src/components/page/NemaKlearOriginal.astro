---
/** Resize the trusted author application rendered from a Tina HTML block. */
---
<script>
 const frames=Array.from(document.querySelectorAll<HTMLIFrameElement>('iframe[data-nemaklear-app]'));
 for(const frame of frames){
  const initialize=()=>frame.contentWindow?.postMessage({type:'nemaklear:init'},location.origin);
  frame.addEventListener('load',initialize);
  initialize();
 }
 window.addEventListener('message',e=>{
  if(e.origin!==location.origin||e.data?.type!=='nemaklear:height')return;
  const frame=frames.find(frame=>e.source===frame.contentWindow);
  const height=Number(e.data.height);
  if(frame&&Number.isFinite(height)&&height>0)frame.style.height=`${Math.ceil(height)+2}px`;
 });
</script>
