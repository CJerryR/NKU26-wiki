---
// Only rendered for model-eco. The HTML marker lives in the Tina content.
---
<template id="model-eco-template">
  <div class="eco-explorer" aria-label="Economic scenario comparison">
    <p class="eco-explorer__eyebrow">Spain · Protected tomato · Literature scenario</p>
    <h3>What changes at this density?</h3>
    <label class="eco-explorer__label">Mi density <span>(J2 / 100 cm³ soil)</span>
      <input data-eco-density type="number" min="0" max="869.6" step="0.1" value="100" inputmode="decimal" aria-describedby="eco-domain eco-error" />
    </label>
    <input data-eco-slider type="range" min="0" max="869.6" step="0.1" value="100" aria-label="Adjust Mi density" />
    <div class="eco-explorer__presets" aria-label="Example densities">
      <button type="button" data-eco-preset="5">Low · 5</button>
      <button type="button" data-eco-preset="40">Middle · 40</button>
      <button type="button" data-eco-preset="100">High · 100</button>
    </div>
    <p id="eco-domain" class="eco-explorer__hint">Economic model domain: 0–869.6 J2/100 cm³. Preset management boundaries: 10 and 80. Testing: 5 EUR/ha.</p>
    <p id="eco-error" class="eco-explorer__error" role="alert" hidden></p>
    <div data-eco-result aria-live="polite" aria-atomic="true">
      <p class="eco-explorer__choice">Preset treatment: <strong data-eco-treatment></strong></p>
      <div class="eco-explorer__comparisons">
        <div><span>Compared with no control</span><strong data-eco-no-control></strong><small>EUR/ha per season</small></div>
        <div><span>Compared with uniform control</span><strong data-eco-uniform></strong><small>EUR/ha per season</small></div>
      </div>
      <div class="table-wrap"><table><caption>Net seasonal income (EUR/ha)</caption><thead><tr><th scope="col">Scenario</th><th scope="col">Net income</th></tr></thead><tbody>
        <tr><th scope="row">No testing, no control</th><td data-eco-income="noControl"></td></tr>
        <tr><th scope="row">No testing, uniform control</th><td data-eco-income="uniform"></td></tr>
        <tr><th scope="row">Testing, graded treatment</th><td data-eco-income="guided"></td></tr>
      </tbody></table></div>
      <p class="eco-explorer__hint" data-eco-interpretation></p>
      <button type="button" class="eco-explorer__download" data-eco-download>Download this scenario (JSON)</button>
    </div>
    <p class="eco-explorer__hint">Conditional calculations from fixed literature and cost assumptions. Density is an input here; no ODE or phone reading is calculated.</p>
  </div>
</template>
<script>
  import config from '../../data/model-eco.json';
  import { evaluateEconomicScenario } from '../../lib/model-eco.mjs';
  const mount = document.querySelector<HTMLElement>('[data-eco-explorer]');
  const template = document.querySelector<HTMLTemplateElement>('#model-eco-template');
  if (mount && template) {
    mount.replaceChildren(template.content.cloneNode(true));
    const input = mount.querySelector<HTMLInputElement>('[data-eco-density]')!;
    const slider = mount.querySelector<HTMLInputElement>('[data-eco-slider]')!;
    const report = mount.querySelector<HTMLElement>('[data-eco-result]')!;
    const error = mount.querySelector<HTMLElement>('#eco-error')!;
    const format = new Intl.NumberFormat('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    let current: ReturnType<typeof evaluateEconomicScenario> | null = null;
    const set = (selector: string, value: string) => { mount.querySelector<HTMLElement>(selector)!.textContent = value; };
    const refresh = () => {
      try {
        if (input.value.trim() === '') throw new RangeError('Enter a density to compare scenarios.');
        current = evaluateEconomicScenario(input.valueAsNumber, config);
        slider.value = String(current.density);
        set('[data-eco-treatment]', current.treatment);
        set('[data-eco-no-control]', format.format(current.benefitVsNoControl));
        set('[data-eco-uniform]', format.format(current.benefitVsUniform));
        for (const field of ['noControl', 'uniform', 'guided'] as const) set(`[data-eco-income="${field}"]`, format.format(current[field]));
        const support = config[current.treatmentKey as 'low' | 'middle' | 'high'].effect.management_support_max;
        set('[data-eco-interpretation]', current.treatmentKey === 'middle'
          ? 'Both programs use the same treatment here. The −5 EUR/ha difference is the added testing cost.'
          : support && current.density > support
            ? 'This density is within the yield model domain but exceeds the stated support range for the high treatment. Interpret this fixed-effect scenario conditionally.'
            : 'The preset rule changes treatment with density. A positive difference depends on the specified prices, treatment effects and costs.');
        error.hidden = true; report.hidden = false; input.removeAttribute('aria-invalid');
      } catch (reason) {
        current = null; report.hidden = true; error.hidden = false;
        error.textContent = reason instanceof Error ? reason.message : 'Check the density.';
        input.setAttribute('aria-invalid', 'true');
      }
    };
    input.addEventListener('input', refresh);
    slider.addEventListener('input', () => { input.value = slider.value; refresh(); });
    mount.querySelectorAll<HTMLButtonElement>('[data-eco-preset]').forEach(button => button.addEventListener('click', () => { input.value = button.dataset.ecoPreset!; refresh(); }));
    mount.querySelector('[data-eco-download]')!.addEventListener('click', () => {
      if (!current) return;
      const blob = new Blob([JSON.stringify({ model: 'Supplied NemaKlear economic scenario, 2026-10-17',
        densityUnit: 'J2/100 cm³ soil', incomeUnit: 'EUR/ha per production season',
        ...current, assumptions: config }, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob); const a = document.createElement('a');
      a.href = url; a.download = `nemaklear-eco-${current.density}.json`; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
    refresh();
  }
</script>
