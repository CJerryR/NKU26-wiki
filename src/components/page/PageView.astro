---
/** One inner page: hero, outline, Markdown body, previous / next. */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SceneHero from './SceneHero.astro';
import { getScene, PORTRAIT_QUERY, GROUND_URL, SKY_URL } from '../../data/scenes';
import Toc from './Toc.astro';
import PagePager from './PagePager.astro';
import NemaKlearOriginal from './NemaKlearOriginal.astro';
import { readingOrder } from '../../data/nav';
import { getPages, byId, pageHref, submittedPages, type PageEntry } from '../../lib/pages';
import { inlineMd, stripMd } from '../../lib/text';

interface Props { entry: PageEntry }
const { entry } = Astro.props;
const data = entry.data;

const { Content, headings, remarkPluginFrontmatter } = await render(entry);
type TocItem = { depth: number; id: string; text: string; num?: string };
const fromPlugin = (remarkPluginFrontmatter as { toc?: TocItem[] } | undefined)?.toc;
const toc: TocItem[] = Array.isArray(fromPlugin) ? fromPlugin
  : headings.filter((h) => h.depth === 2).map((h, i) => ({ depth: 2, id: h.slug, text: h.text, num: String(i + 1).padStart(2, '0') }));

const ids = byId(await getPages());
const order = readingOrder().filter((l) => ids.has(l.page));
const at = order.findIndex((l) => l.page === entry.id);
const link = (i: number) => {
  const l = order[i];
  const target = l ? ids.get(l.page) : undefined;
  return l && target ? { href: pageHref(target), title: l.label, blurb: !target.body?.trim() || ['attributions', 'members', 'part-collection', 'model-1', 'model-2'].includes(l.page) ? undefined : l.blurb } : null;
};
const prev = at > 0 ? link(at - 1) : null;
const next = at >= 0 && at < order.length - 1 ? link(at + 1) : null;
const description = data.description ?? (data.sub ? stripMd(data.sub) : undefined);
// Scroll-opened hero where this page has an enabled scene; the SVG title bar otherwise.
const scene = getScene(entry.id);
const preload = scene ? [
  { href: SKY_URL, media: 'all' },
  { href: GROUND_URL, media: 'all' },
  { href: scene.sets.desktop.url, media: `not all and ${PORTRAIT_QUERY}` },
  { href: scene.sets.mobile.url, media: PORTRAIT_QUERY },
] : [];
---
<BaseLayout title={data.title} description={description} current={pageHref(entry)} skipTo="#content" preload={preload}>
  {scene
    ? <SceneHero scene={scene} title={data.title} heading={data.heading} crumbs={data.crumbs} />
    : <PageHero title={data.title} heading={data.heading} sub={data.sub} crumbs={data.crumbs} meta={data.meta} />}
  <div id="content" tabindex="-1" class:list={['doc', { 'doc--no-toc': toc.length === 0 }]} data-tone="light" data-page={entry.id} data-reading={submittedPages.has(entry.id) ? 'submitted' : undefined}>
    <Toc items={toc} title={data.title} />
    <article class="doc__body prose" data-doc>
      {scene && data.sub && <p class="scene-intro" set:html={inlineMd(data.sub)} />}
      {entry.body?.includes('data-nemaklear-app') && <NemaKlearOriginal />}
      <Content />
      {entry.id === 'results' && <script is:inline>
        const siteBase = new URL('../', location.href);
        const expectedWidget = new URL('widgets/html.html', siteBase);
        const expectedEmbed = new URL('embeds/results-future-work-20261021/index.html', siteBase);
        const futureWorkFrame = Array.from(document.querySelectorAll('iframe.wiki-media__frame')).find(frame => {
          try {
            const viewer = new URL(frame.src, location.href);
            const rawEmbedSource = viewer.searchParams.get('src') || '';
            const embedSource = rawEmbedSource.startsWith('/embeds/')
              ? new URL(rawEmbedSource.slice(1), siteBase)
              : rawEmbedSource.startsWith('/')
                ? new URL(rawEmbedSource, location.origin)
                : new URL(rawEmbedSource, siteBase);
            return viewer.origin === location.origin
              && viewer.href.split('?')[0] === expectedWidget.href
              && embedSource.href === expectedEmbed.href
              && viewer.searchParams.get('scripts') === '1';
          } catch { return false; }
        });
        if (futureWorkFrame) window.addEventListener('message', event => {
          const height = Number(event.data?.height);
          if (event.source !== futureWorkFrame.contentWindow || event.origin !== location.origin
            || event.data?.type !== 'nku-results-future-work:height'
            || !Number.isFinite(height) || height < 300 || height > 2800) return;
          futureWorkFrame.style.height = `${Math.ceil(height)}px`;
        });
      </script>}
    </article>
  </div>
  <PagePager prev={prev} next={next} />
</BaseLayout>
