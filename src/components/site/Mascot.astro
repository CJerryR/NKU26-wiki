---
/** The yeast detective (bottom-left). Tap to switch between day and night (src/scripts/mascot.ts). */
---
<div class="detective" data-detective>
  <p class="detective__bubble" role="status" aria-live="polite"></p>
  <button type="button" class="detective__btn" aria-label="Yeast detective: night mode" aria-pressed="false">
    <img src="https://static.igem.wiki/teams/6303/wiki/v8-0/v8-ea3470efac8f-detective.avif" width="120" height="110" alt="" />
  </button>
</div>
