---
/** The yeast detective (bottom-left). Tap to go back to the top. */
---
<div class="detective" data-detective>
  <p class="detective__bubble" role="status" aria-live="polite"></p>
  <button type="button" class="detective__btn" aria-label="Yeast detective: back to the top">
    <img src="/img/shell/detective.png" width="120" height="110" alt="" />
  </button>
</div>
