---
import { footerNav } from '../../data/nav';
import { site } from '../../data/site';
import { socialIcons } from '../../data/social-icons';
import { getPages, byId, pageHref } from '../../lib/pages';

const ids = byId(await getPages());
const columns = footerNav.map((col) => ({
  label: col.label,
  links: col.items.map((l) => {
    const entry = ids.get(l.page);
    return entry ? { label: l.label, href: pageHref(entry) } : null;
  }).filter((l): l is { label: string; href: string } => l !== null),
}));
// A sponsor whose logo file has not arrived yet shows its name instead (site.logoUrl).
const sponsors = site.sponsors.map((s) => ({ ...s, url: site.safeUrl(s.url), logo: site.logoUrl(s.logo) }));
const friends = site.friends.map((s) => ({ ...s, url: site.safeUrl(s.url) }));
---
<footer class="site-footer" data-tone="dark" data-free-scroll>
  <div class="site-footer__seal" aria-hidden="true"><img src="https://static.igem.wiki/teams/6303/wiki/v8-6/nankai-seal-en.webp" alt="" width="648" height="216" loading="lazy" /></div>
  <div class="site-footer__edge" aria-hidden="true">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path class="edge-layer-front" d="M0,0 H1440 V80 C1250,111 1040,65 760,88 C480,110 260,60 0,82 Z" />
      <path class="edge-layer-back" d="M0,0 H1440 V56 C1240,88 1030,42 740,64 C470,86 220,34 0,60 Z" />
      <path class="edge-top" d="M0,0 H1440 V36 C1230,68 1020,12 720,40 C420,68 240,10 0,38 Z" />
    </svg>
  </div>
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <div class="site-footer__identity">
      <a href="/index.html" class="site-footer__logo" aria-label="NKU-China NemaKlear home">
        <img src="https://static.igem.wiki/teams/6303/wiki/v8-0/v8-3439b58a1e73-nku-mark.svg" alt="" width="30" height="39" loading="lazy" />
        <span><b>NKU-China</b><em>NemaKlear</em></span>
      </a>
      <p><b>{site.team}</b></p>
      </div>
      <div class="site-footer__about">
      <p class="site-footer__tagline">Small signals, big possibilities.</p>
      </div>
    </div>
    {columns.map((col) => (
      <nav class="site-footer__col" aria-label={col.label}>
        <h2>{col.label}</h2>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <nav class="site-footer__resources" aria-label="Team and project resources">
    <a class="site-footer__social" data-resource="team" href={site.teamPage} aria-label="Official team page" title="Official team page" style="--social-color: #7e3f8f">
      <span class="site-footer__social-mark" aria-hidden="true"></span>
    </a>
    <a href="https://www.nankai.edu.cn/">Nankai University</a>
    <a href="/licensing/">Licensing &amp; AI use</a>
    {site.repository && <a class="site-footer__social" data-resource="gitlab" href={site.repository} aria-label="GitLab source code" title="GitLab source code" style="--social-color: #fc6d26">
      <span class="site-footer__social-mark" aria-hidden="true"></span>
    </a>}
    <span class="site-footer__socials" role="group" aria-label="Team social media">
      {socialIcons.map(({ key, label, color }) => {
        const configured = site.safeUrl(site.socialLinks[key]);
        const href = /^https:\/\//i.test(configured) ? configured : '';
        return <a class="site-footer__social" data-platform={key} href={href || undefined} role="link"
          aria-label={label} aria-disabled={href ? undefined : 'true'}
          title={href ? label : `${label} · Coming soon`} style={`--social-color: ${color}`}>
          <span class="site-footer__social-mark" aria-hidden="true"></span>
        </a>;
      })}
    </span>
  </nav>
  {friends.length > 0 && (
    <section class="site-footer__friends" aria-label="Friend teams">
      <h2>Friend links</h2>
      <ul>{friends.map((f) => <li>{f.url ? <a href={f.url}>{f.name}</a> : f.name}{f.note && <span>{f.note}</span>}</li>)}</ul>
    </section>
  )}
  <div class="site-footer__bottom">
  <div class="site-footer__legal">
    <span>&copy; 2026 NKU iGEM Team &middot; <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></span>
  </div>
  <details class="site-footer__credits">
    <summary>Credits, licenses &amp; AI use</summary>
    <div>
    <span>Fraunces, Spline Sans &amp; Space Mono: SIL OFL 1.1 &middot; Three.js: MIT</span>
    <span>Social icons: <a href="https://simpleicons.org/">Simple Icons 16.0.0</a>, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>. Brand names and logos belong to their respective owners.</span>
    <span><a href="https://katex.org/">KaTeX</a> rendering and fonts: <a href="/widgets/vendor/katex/LICENSE">MIT</a></span>
    <span>AI assistance in Wiki development: Anthropic Claude Opus 4.7, 4.8, 5.0 and 5.5; OpenAI GPT-6 Astra, GPT-6.1 Sol and GPT-6 Luna (build code, debugging, code review and translation of team-written text). Human review of final project content remains pending. Decorative artwork is illustrative, not scientific evidence.</span>
    <span>Inner-page opening illustrations: generated with OpenAI gpt-image-2.5, using team-provided artwork and layouts as references, and released under CC BY 4.0. These are decorative illustrations, not experimental images or model results.</span>
    <span data-institutional-credit="nankai-university"><a href="https://www.nankai.edu.cn/">Nankai University emblem</a>; animation recovered from the <a href="https://github.com/CJerryR/NKU26-wiki/blob/e283a55/img/nankai-seal.gif">earlier team Wiki</a>, its caption rewritten in English. Institutional marks are excluded from CC BY 4.0.</span>
    <span>Basemaps: Natural Earth (public domain); China: Standard Map of China, GS(2022)4308. Project component and system validation remain open.</span>
    </div>
  </details>
  {sponsors.length > 0 && (
    <section class="site-footer__sponsors" aria-label="Sponsors and partners">
      <ul>
        {sponsors.map((s) => {
          const Tag = s.url ? 'a' : 'div';
          return <li data-logo-wide={s.logoWide || undefined}><Tag class="site-footer__sponsor" data-logo-background={s.logoBackground} href={s.url || undefined}>
            {s.logo ? <img src={s.logo} alt={s.logoAlt || s.name} width="160" height="64" loading="lazy" /> : <b class="site-footer__sponsor-name" title={s.logoAlt || s.name}>{s.short || s.name}</b>}
          </Tag></li>;
        })}
      </ul>
    </section>
  )}
  </div>
</footer>
