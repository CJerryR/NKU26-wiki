<!-- Temporary review round preference, applied before paint on every page. -->
<script is:inline>
  for (const store of ['localStorage', 'sessionStorage']) {
    try {
      if (window[store].getItem('nku26-review-hidden-round-20261018') === '1') {
        document.documentElement.setAttribute('data-review-hidden', '');
        break;
      }
    } catch (_) {}
  }
</script>
<style is:global>
  html[data-review-hidden] .lnav__review-orb,
  html[data-review-hidden] .change-notice { display: none !important; }
</style>
