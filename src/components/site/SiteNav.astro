---
/**
 * Top bar: two floating glass islands (brand + menu), dropdowns and the phone
 * sheet. The markup matches v6 exactly, so the story homepage keeps running
 * on its own static/js/shell.js while inner pages use src/scripts/nav.ts.
 */
import Glass from '../glass/Glass.astro';
import { primaryNav, mobileNav } from '../../data/nav';
import { getPages, byId, pageHref } from '../../lib/pages';

interface Props { current?: string }
const { current = '' } = Astro.props;

const ids = byId(await getPages());
const HOME = '/index.html';
function href(page: string): string | null {
  if (page === 'home') return HOME;
  const entry = ids.get(page);
  if (!entry) { console.warn(`[nav] no page "${page}" in src/content/pages — link skipped`); return null; }
  return pageHref(entry);
}
const here = (page: string) => href(page) === current;
const menu = primaryNav.map((item) => {
  if (item.kind === 'home') return { ...item, href: HOME, current: current === HOME };
  if (item.kind === 'link') return { ...item, href: href(item.page), current: here(item.page) };
  const items = item.items.map((l) => ({ ...l, href: href(l.page), current: here(l.page) })).filter((l) => l.href);
  return { ...item, items, current: items.some((l) => l.current) };
});
const sheet = mobileNav.map((g) => ({ ...g, items: g.items.map((l) => ({ ...l, href: href(l.page), current: here(l.page) })).filter((l) => l.href) }));
---
<header class="lnav" data-lnav>
  <div class="lnav__row lnav__bar">
    <Glass class="lnav__island lnav__island--brand" preset="bar">
      <a href={HOME} class="lnav__brand" aria-label="NKU26 NemaKlear home">
        <img src="/img/shell/nku-mark.svg" alt="" width="34" height="44" />
        <span><b>NKU26</b><em>NemaKlear</em></span>
      </a>
    </Glass>
    <Glass class="lnav__island lnav__island--menu" preset="bar">
      <span class="lnav__now" data-lnav-now aria-hidden="true"></span>
      <nav class="lnav__links" aria-label="Primary">
        <span class="lnav__lens lg" data-lg="lens" aria-hidden="true"><span class="lg__fx"></span><span class="lg__shine"></span></span>
        {menu.map((item) => item.kind === 'group' ? (
          <div class="lnav__group">
            <button type="button" class:list={['lnav__link', { 'is-current': item.current }]} aria-expanded="false" aria-controls={`lnav-${item.id}`}>{item.label}<svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg></button>
            <Glass class={item.narrow ? 'lnav__drop lnav__drop--narrow' : 'lnav__drop'} id={`lnav-${item.id}`} preset="drop">
              <div class="lnav__drop-grid">
                {item.items.map((l) => (
                  <a href={l.href} aria-current={l.current ? 'page' : undefined}><b>{l.label}</b><span>{l.blurb}</span></a>
                ))}
              </div>
            </Glass>
          </div>
        ) : item.href && (
          <a class:list={['lnav__link', { 'is-current': item.current }]} href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <button type="button" class="lnav__search" data-search-open aria-haspopup="dialog" aria-controls="site-search" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><line x1="20" y1="20" x2="16" y2="16" /></svg>
        <span>Search</span>
      </button>
      <button type="button" class="lnav__toggle" aria-expanded="false" aria-controls="lnav-sheet" aria-label="Open menu"><i></i><i></i></button>
    </Glass>
  </div>
  <Glass class="lnav__sheet" id="lnav-sheet" preset="sheet" hidden>
    <div class="lnav__sheet-body">
      {sheet.map((g) => (
        <Fragment>
          {g.label && <p>{g.label}</p>}
          {g.items.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
        </Fragment>
      ))}
    </div>
  </Glass>
</header>
<svg class="lg-defs" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden"><defs></defs></svg>
