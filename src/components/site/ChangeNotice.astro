---
/** One shared reminder across the homepage and every article. */
import { readFileSync } from 'node:fs';

const readmePath = `${process.cwd()}/README.md`;
const readme = readFileSync(readmePath, 'utf8');
const history = readme.split('## 版本改动')[1] ?? '';
const versions = [...history.matchAll(/### (V[\d.]+) 改动：\s*([\s\S]*?)(?=### |$)/g)]
  .map(([, version, body]) => ({
    version,
    changedAt: body.match(/^改动时间[：:]\s*(.+)$/m)?.[1] ?? '',
    entries: [...body.matchAll(/^(\d+)\. (.+)$/gm)]
      .map(([, number, text]) => ({ number, text })),
  }))
  .sort((a, b) => b.version.localeCompare(a.version, undefined, { numeric: true }));

---
<dialog id="change-notice" class="change-notice lg-glass" data-glass="panel" data-tone="light" data-change-notice aria-labelledby="change-notice-title" lang="zh-CN">
  <span class="lg-surface" aria-hidden="true"></span>
  <div class="change-notice__heading">
    <div class="change-notice__title-row">
      <h2 id="change-notice-title">改动清单</h2>
    </div>
    <button class="change-notice__close" type="button" data-notice-close aria-label="关闭改动清单">×</button>
  </div>
  <div class="change-notice__history" tabindex="0" role="region" aria-label="版本改动记录">
    {versions.map(({ version, changedAt, entries }) => <section>
      <h3>{version}{changedAt && <span class="change-notice__updated">{changedAt}</span>}</h3>
      <ol class="change-notice__list">
        {entries.map(({ number, text }) => <li value={Number(number)}>{text}</li>)}
      </ol>
    </section>)}
  </div>
  <div class="change-notice__footer">
    <button type="button" class="change-notice__hide" data-notice-hide aria-label="隐藏本轮提醒" title="隐藏本轮提醒">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18M10.6 5.2 12 5c5.5 0 9 7 9 7a17 17 0 0 1-3.1 3.9M6.2 6.2C4.2 7.7 3 10 3 12c0 0 3.5 7 9 7a9 9 0 0 0 4.1-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
    </button>
    <button class="change-notice__confirm" type="button" data-notice-close autofocus>知道了</button>
  </div>
</dialog>

<script>
  import { glassFor } from '../../scripts/liquid-glass';
  const notice = document.querySelector<HTMLDialogElement>('[data-change-notice]');
  const key = 'nku26-change-notice-seen-v2';
  const hideKey = 'nku26-review-hidden-round-20261018';
  let dismissed = document.documentElement.hasAttribute('data-review-hidden');
  let seen = false;
  // localStorage also prevents repeats after a refresh or a later visit.
  // Session storage is a fallback when persistent storage is unavailable.
  for (const name of ['localStorage', 'sessionStorage'] as const) {
    try {
      seen ||= window[name].getItem(key) === '1';
      dismissed ||= window[name].getItem(hideKey) === '1';
    } catch { /* Storage may be disabled. */ }
  }
  if (notice) {
    let previousFocus: HTMLElement | null = null;
    const open = () => {
      if (dismissed || notice.open) return;
      previousFocus = document.activeElement as HTMLElement | null;
      const tone = document.querySelector('.lnav__island--menu')?.getAttribute('data-tone') ?? 'light';
      notice.setAttribute('data-tone', tone);
      notice.showModal();
      glassFor(notice).refresh();
    };
    const hide = () => {
      dismissed = true;
      document.documentElement.setAttribute('data-review-hidden', '');
      notice.close();
    };
    if (dismissed) hide();
    notice.querySelector('[data-notice-hide]')?.addEventListener('click', () => {
      for (const name of ['localStorage', 'sessionStorage'] as const) {
        try { window[name].setItem(hideKey, '1'); } catch { /* Keep this page hidden even without storage. */ }
      }
      hide();
    });
    window.addEventListener('storage', event => {
      if (event.key === hideKey && event.newValue === '1') hide();
    });
    document.querySelectorAll('[data-notice-open]').forEach(button => {
      button.addEventListener('click', open);
    });
    if (!seen && !dismissed) {
      open();
    for (const name of ['localStorage', 'sessionStorage'] as const) {
      try { window[name].setItem(key, '1'); } catch { /* The reminder still works without storage. */ }
    }
    }
    notice.querySelectorAll('[data-notice-close]').forEach(button => {
      button.addEventListener('click', () => notice.close());
    });
    notice.addEventListener('click', event => {
      if (event.target !== notice) return;
      const box = notice.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) notice.close();
    });
    // Keep the homepage's keyboard and gesture paging behind the modal idle.
    for (const type of ['wheel', 'touchmove', 'keydown']) {
      notice.addEventListener(type, event => event.stopPropagation());
    }
    notice.addEventListener('close', () => previousFocus?.focus({ preventScroll: true }));
  }
</script>

<style>
  .change-notice {
    box-sizing: border-box; position: fixed; inset: 0; margin: auto;
    width: min(560px, calc(100vw - 32px)); max-height: calc(100dvh - 40px);
    padding: 28px; overflow-y: auto; overscroll-behavior: contain;
    color: var(--glass-ink); background: transparent; border: 0;
    border-radius: 28px; box-shadow: var(--glass-shadow);
    font: 15px/1.65 system-ui, sans-serif; text-align: left;
  }
  .change-notice::backdrop { background: #160e2b45; backdrop-filter: blur(3px); }
  .change-notice__heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .change-notice__title-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 14px; }
  .change-notice button { cursor: pointer; font: inherit; letter-spacing: normal; text-transform: none; }
  .change-notice__close { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; background: var(--glass-film); color: inherit; font-size: 24px !important; }
  .change-notice h2 { margin: 0; font: 750 28px/1.3 system-ui, sans-serif; color: inherit; letter-spacing: normal; }

  .change-notice p { margin: 0; font: inherit; color: inherit; }
  .change-notice__updated { margin-left: 12px; font-size: 12px; font-weight: 400; line-height: 1.5; color: inherit; opacity: .7; }
  .change-notice__history { margin: 20px 0; max-height: min(48dvh, 420px); overflow-y: auto; overscroll-behavior: contain; padding-right: 12px; scrollbar-width: thin; }
  .change-notice__history section + section { margin-top: 24px; }
  .change-notice h3 { margin: 0 0 12px; color: inherit; font: 750 17px/1.4 system-ui, sans-serif; }
  .change-notice__list { margin: 0; padding: 0 0 0 28px; list-style: decimal; display: grid; gap: 10px; }
  .change-notice__list li { margin: 0; padding: 0 0 0 5px; font-size: 14px; }
  .change-notice__list li::marker { color: inherit; opacity: .55; font-variant-numeric: tabular-nums; }
  .change-notice__footer { display: flex; align-items: center; justify-content: flex-end; gap: 14px; border-top: 1px solid var(--glass-film-edge); padding-top: 20px; }
  .change-notice__confirm { padding: 11px 18px; border: 0; border-radius: 12px; background: var(--glass-film); color: inherit; box-shadow: inset 0 1px 0 var(--glass-film-edge); font-weight: 650 !important; }
  .change-notice button:focus-visible { outline: 3px solid #a58abb; outline-offset: 3px; }
  .change-notice[data-tone="dark"] { --glass-tint: rgb(26 14 34 / .65); }
  .change-notice__hide { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; margin-right: auto; border: 0; border-radius: 50%; background: transparent; color: inherit; opacity: .45; }
  .change-notice__hide:hover, .change-notice__hide:focus-visible { opacity: 1; background: var(--glass-film); }
  :global(html:has(.change-notice[open])) { overflow: hidden; }
  @media (max-width: 480px) { .change-notice { padding: 22px; border-radius: 20px; } }
</style>
