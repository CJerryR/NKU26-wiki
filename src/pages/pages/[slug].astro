---
/** Pages without a `route`: pages/<file name>.html */
import PageView from '../../components/page/PageView.astro';
import { getPages } from '../../lib/pages';

export async function getStaticPaths() {
  const pages = await getPages();
  // Keep the addresses used before the new standard routes were assigned.
  return pages.filter((entry) => !entry.data.route || ['protocols', 'part-collection'].includes(entry.id)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const legacyArchive = ['model-1', 'model-2'].includes(entry.id);
const { Content } = legacyArchive ? await entry.render() : { Content: null };
---
{legacyArchive ? (
  <html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><title>{entry.data.title} / NKU iGEM 2026</title></head>
  <body><main><h1>{entry.data.heading}</h1><p>{entry.data.sub}</p><Content /></main></body></html>
) : <PageView entry={entry} />}
<style>main{max-width:65rem;margin:4rem auto;padding:1rem;font:1.1rem/1.65 system-ui,sans-serif}a{color:#523a8c}</style>
