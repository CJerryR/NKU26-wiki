---
import { getCollection } from 'astro:content';
import PageView from '../../../../components/page/PageView.astro';
import '../../../../styles/project-feishu-preview.css';
export async function getStaticPaths() {
  return (await getCollection('projectPreviews')).map(entry => ({ params: { page: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<PageView entry={entry} projectPreview />
