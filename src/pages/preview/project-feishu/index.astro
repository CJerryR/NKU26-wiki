---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const pages = ['description', 'engineering', 'contribution'];
---
<BaseLayout comparison title="Project version comparison" description="Temporary comparison of current Project pages and the Project.docx backup.">
  <section class="comparison">
    <p>Temporary preview · Project.docx backup</p>
    <h1>Compare Project versions</h1>
    <p>The current pages and this backup remain available side by side. Choose a version after review.</p>
    <table><thead><tr><th>Page</th><th>Current version</th><th>Project.docx backup</th></tr></thead>
      <tbody>{pages.map(slug => <tr><th>{slug}</th><td><a href={`/${slug}/`}>Open current</a></td><td><a href={`/preview/project-feishu/${slug}/`}>Open backup</a></td></tr>)}</tbody>
    </table>
    <p>Pending team review: Engineering 3.3 needs the correct ΔB figure; permission for the classroom photograph needs confirmation.</p>
  </section>
</BaseLayout>
<style>
  .comparison { max-width: 65rem; margin: 8rem auto 4rem; padding: 24px; }
  table { width:100%; border-collapse:collapse; margin:2rem 0; } th, td { padding:16px 8px; text-align:left; border-bottom:1px solid var(--line); }
  h1 { font-size:clamp(30px,4vw,48px); } p { line-height:1.7; }
  @media(max-width:640px) { th,td { padding:12px 4px; font-size:14px; } }
</style>
