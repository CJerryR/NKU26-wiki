  "model-eco": [
    {
      "preceding_text": "An increase in income after testing can reflect both the benefit of nematode control and the benefit of choosing treatment using density information. To distinguish these effects, we compare three scenarios:",
      "rows": [
        [
          "Scenario",
          "Management approach"
        ],
        [
          "No testing, no control",
          "No additional nematode-specific treatment"
        ],
        [
          "No testing, uniform treatment",
          "The same fluopyram program is applied regardless of density"
        ],
        [
          "Test-guided treatment",
          "The density estimate determines whether to use no dedicated control, a medium-tier treatment, or a high-tier treatment"
        ]
      ],
      "source_workbook": "workspace/evidence/model-refresh-20261020/originals/Model -_ Economic Benefit-word/Microsoft_Excel_Worksheet1.xlsx",
      "sha256": "1786ac79c70ffabc3b7b53275fce12481689d61face8a1c089bc74a203ab7c29",
      "empty": false
    },
    {
      "preceding_text": "The test-guided scenario follows the preset rules below. Treatment options are drawn from the literature [2].",
